# Salin file ini menjadi .env dan isi dengan URL serta Anon Key dari Project Supabase kamu
# (Atau kamu juga bisa memasukkannya langsung melalui menu "Cloud Database (Supabase)" di dalam aplikasi BeeMate)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
